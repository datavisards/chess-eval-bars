{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@site/*": ["./*"],
      "chess-eval-bars": ["../src/index.ts"],
      "ceb-examples/*": ["../examples/*"]
    }
  }
}
